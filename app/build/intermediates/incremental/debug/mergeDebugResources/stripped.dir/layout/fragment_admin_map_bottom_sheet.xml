<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background">

    <!-- Indikator garis atas -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <!-- Judul Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peta Pantau Semua User (Admin)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/textContent"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Peta Osmdroid Full Screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapAdminView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Panel Kontrol & Informasi User yang Dipilih (Compact Mode) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Label Filter User -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter User:"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="?attr/textContent"
            android:layout_marginBottom="4dp"/>

        <!-- Container Horizontal untuk Checkbox Filter User -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/containerCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <!-- Kotak Informasi User Terpilih -->
        <TextView
            android:id="@+id/tvInfoUserAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih marker user di peta..."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/textContent"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <!-- Tombol Utama: Salin Koordinat (Dibuat compact tinggi 38dp) -->
        <Button
            android:id="@+id/btnSalinKoordinatAdmin"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Salin Koordinat User Ini"
            android:textSize="12sp"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginBottom="6dp"
            android:elevation="0dp"
            android:paddingHorizontal="4dp"/>

        <!-- Baris Tombol Kontrol (Keempat tombol digabung menjadi 1 baris agar sangat ringkas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnZoomInAdmin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Zoom +"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="2dp"/>

            <Button
                android:id="@+id/btnZoomOutAdmin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Zoom -"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="2dp"/>

            <Button
                android:id="@+id/btnStandardAdmin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Normal"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="2dp"/>

            <Button
                android:id="@+id/btnSatelliteAdmin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Satelit"
                android:textSize="11sp"
                android:paddingHorizontal="2dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>