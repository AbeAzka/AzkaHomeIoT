<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background">

    <!-- Indikator garis atas -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peta Pantau Semua User (Admin)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/textContent"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Peta Osmdroid Full Screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapAdminView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Panel Kontrol & Informasi User yang Dipilih -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_card">

        <!-- Label Filter User -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter User:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/textContent"
            android:layout_marginBottom="4dp"/>

        <!-- Container Horizontal untuk Checkbox Filter User -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/containerCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvInfoUserAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih marker user di peta..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/textContent"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSalinKoordinatAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salin Koordinat User Ini"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnZoomInAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zoom +"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnZoomOutAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zoom -"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnStandardAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Peta Normal"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnSatelliteAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Peta Satelit"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>