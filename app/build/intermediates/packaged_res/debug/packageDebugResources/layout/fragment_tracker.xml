<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- Judul Halaman -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Realtime GPS Tracker"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/textContent"
        android:layout_marginBottom="8dp"
        android:gravity="center"/>

    <!-- Informasi Multi-User Aktif -->
    <TextView
        android:id="@+id/tvUserAktif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login sebagai: Memuat..."
        android:textSize="13sp"
        android:textColor="?attr/textContent"
        android:layout_marginBottom="20dp"/>

    <!-- Kartu Informasi Koordinat -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/cardBG">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="#2196F3"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvKoordinat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="Lokasi belum tersedia"
                android:textSize="15sp"
                android:textColor="?attr/textContent"
                android:gravity="center"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tombol-tombol Kontrol -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMulai"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Mulai Tracker"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="#4CAF50"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBukaPeta"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Buka Peta Lokasi"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        app:backgroundTint="#2196F3"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Salin Koordinat"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        app:backgroundTint="#FF9800"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBagikan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Bagikan Lokasi"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        app:backgroundTint="#9C27B0"
        app:cornerRadius="12dp"/>

</LinearLayout>