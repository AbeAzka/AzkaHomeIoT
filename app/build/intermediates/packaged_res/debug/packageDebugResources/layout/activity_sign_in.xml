<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"

    android:background="@drawable/ui_login"
    tools:context=".SignInActivity"
    >


    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Azka Home IoT"
        android:textAlignment="center"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="120dp"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:textStyle="bold" />


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="50dp"

        app:cardCornerRadius="30dp"
        app:cardElevation="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            android:padding="24dp"
            android:background="@drawable/custom_edittext">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome,"
                android:id="@+id/loginText"
                android:textSize="36sp"

                android:textStyle="bold"
                android:textColor="@color/lavender"/>
            <TextView
                android:id="@+id/lgg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"


                android:text="Please Sign in to continue!"

                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button

                android:id="@+id/gSignInPct"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:background="@drawable/roundshp"
                android:drawableLeft="@drawable/google_pct"
                android:drawablePadding="8dp"
                app:backgroundTint="#F2F2F2"
                android:layout_gravity="center|top"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Sign in with Google"
                android:textAllCaps="false"
                android:textColor="#1F1F1F "
                android:textStyle="bold" />

            <Button

                android:id="@+id/idsLogin"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:background="@drawable/roundshp"
                android:drawableLeft="@drawable/idspct"
                android:drawablePadding="8dp"
                app:backgroundTint="@color/colorPrimaryDark"
                android:layout_gravity="center|top"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Sign in with IndodevStudio account"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />



            <TextView
                android:id="@+id/ingf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginTop="10dp"
                android:text="Copyright @ 2025 Abe Azka"
                android:gravity="center"
                android:textSize="18dp"
                android:textStyle="normal"
                android:layout_marginBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>





    </androidx.cardview.widget.CardView>





</LinearLayout>
