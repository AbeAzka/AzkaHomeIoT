<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Section - Compact -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS Tracker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/textContent"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvUserAktif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login sebagai: Memuat..."
            android:textSize="12sp"
            android:textColor="?attr/textContent"
            android:alpha="0.7"/>
    </LinearLayout>

    <!-- ScrollView untuk content yang bisa di-scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Location Information Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="?attr/cardBG">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="#2196F3"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lokasi Saat Ini"
                        android:textSize="12sp"
                        android:textColor="?attr/textContent"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:alpha="0.6"/>

                    <TextView
                        android:id="@+id/tvKoordinat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:text="Lokasi belum tersedia"
                        android:textSize="14sp"
                        android:textColor="?attr/textContent"
                        android:gravity="center"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tracking Control Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBG">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMulai"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Mulai Tracker"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#4CAF50"
                    app:cornerRadius="14dp"
                    android:layout_margin="8dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </androidx.cardview.widget.CardView>

            <!-- Map Controls Card - Grid Layout -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBG">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:spacing="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBukaPeta"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Peta Saya"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#2196F3"
                            app:cornerRadius="12dp"
                            android:layout_margin="4dp"
                            style="@style/Widget.MaterialComponents.Button"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBukaPetaSemua"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Semua Lokasi"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#002F54"
                            app:cornerRadius="12dp"
                            android:layout_margin="4dp"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sharing Controls Card - Grid Layout -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBG">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:spacing="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSalin"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Salin"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#FF9800"
                            app:cornerRadius="12dp"
                            android:layout_margin="4dp"
                            style="@style/Widget.MaterialComponents.Button"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBagikan"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Bagikan"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#9C27B0"
                            app:cornerRadius="12dp"
                            android:layout_margin="4dp"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Settings Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/cardBG">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Pengaturan"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#607D8B"
                    app:cornerRadius="14dp"
                    android:layout_margin="8dp"
                    app:icon="@android:drawable/ic_menu_preferences"
                    style="@style/Widget.MaterialComponents.Button"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>