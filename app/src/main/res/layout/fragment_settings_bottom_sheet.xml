<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_background">

    <!-- Garis Indikator Atas -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/drag_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan Tracker"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan Umum"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/textContent"
        android:layout_marginBottom="16dp"/>

    <!-- Bagian 1: Notifikasi -->
    <Switch
        android:id="@+id/switchNotifikasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tampilkan Notifikasi Background"
        android:textSize="15sp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="12dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="12dp"/>

    <!-- Bagian 2: Pengaturan Tracker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfigurasi Tracker"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/textContent"
        android:layout_marginBottom="8dp"/>

    <Switch
        android:id="@+id/switchAutoStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto-Start Tracker saat Aplikasi Dibuka"
        android:textSize="15sp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Bagian 3: Interval Pengiriman -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Interval Pengiriman Lokasi"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/textContent"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerInterval"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="8dp"/>

</LinearLayout>